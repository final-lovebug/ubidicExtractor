# Gemini
# 키 1개만 쓰려면 GEMINI_API_KEY 하나만 채우면 된다(기존 방식 그대로 동작).
# 여러 개 등록하면 1번부터 순서대로 쓰다가, 그 키가 쿼터 소진(429)·인증
# 실패(401/403)로 막히면 자동으로 다음 번호로 넘어간다(§10 D-38).
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# 콘솔에서 현재 사용 가능한 모델을 확인해 채운다 (긴 컨텍스트 + 저비용 계열)
# 모델 하나만 쓰려면 GEMINI_MODEL 하나만 채우면 된다(기존 방식 그대로 동작).
# 여러 개 등록하면 --model 없이 실행할 때 1번부터 순서대로 쓰다가, 등록된
# 키를 전부 써도 그 모델이 안 되면(쿼터 소진·인증 실패·서버 과부하) 자동으로
# 다음 번호로 넘어간다(§10 D-40). `--model`을 명시하면 이 목록은 무시되고
# 그때 준 값(콤마로 여러 개 나열 가능, §10 D-39)만 쓴다.
GEMINI_MODEL=
# GEMINI_MODEL_1=
# GEMINI_MODEL_2=

# 판정 재현성을 위해 올리지 말 것
GEMINI_TEMPERATURE=0.1

# 안전장치
MAX_LLM_CALLS=20
LLM_CACHE_DIR=.cache
