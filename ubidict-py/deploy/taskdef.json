{
  "family": "ubidict-py",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${TASK_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "ubidict-py",
      "image": "<IMAGE1_NAME>",
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "${AWS_REGION}" }
      ],
      "secrets": [
        { "name": "GEMINI_API_KEY_1", "valueFrom": "${SECRETS_MANAGER_ARN}:GEMINI_API_KEY_1::" },
        { "name": "GEMINI_API_KEY_2", "valueFrom": "${SECRETS_MANAGER_ARN}:GEMINI_API_KEY_2::" },
        { "name": "MYSQL_HOST", "valueFrom": "${SECRETS_MANAGER_ARN}:MYSQL_HOST::" },
        { "name": "MYSQL_USER", "valueFrom": "${SECRETS_MANAGER_ARN}:MYSQL_USER::" },
        { "name": "MYSQL_PASSWORD", "valueFrom": "${SECRETS_MANAGER_ARN}:MYSQL_PASSWORD::" },
        { "name": "MYSQL_DATABASE", "valueFrom": "${SECRETS_MANAGER_ARN}:MYSQL_DATABASE::" },
        { "name": "SQS_REQUEST_QUEUE_URL", "valueFrom": "${SECRETS_MANAGER_ARN}:SQS_REQUEST_QUEUE_URL::" },
        { "name": "SQS_REPLY_QUEUE_URL", "valueFrom": "${SECRETS_MANAGER_ARN}:SQS_REPLY_QUEUE_URL::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ubidict-py",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ubidict-py"
        }
      }
    }
  ]
}
