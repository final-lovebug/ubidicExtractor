# Gemini — test/.env.example과 동일한 규칙(§10 D-38~D-40, test/SPEC.md §6 참고)
# 키 1개만 쓰려면 GEMINI_API_KEY 하나만 채우면 된다.
# 여러 개 등록하면 1번부터 순서대로 쓰다가, 그 키가 쿼터 소진(429)·인증
# 실패(401/403)·무효 키(400 API_KEY_INVALID)로 막히면 자동으로 다음 번호로
# 넘어간다.
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# 모델도 마찬가지 — 하나만 쓰려면 GEMINI_MODEL만. 여러 개 등록하면 등록된
# 키를 전부 써도 그 모델이 안 될 때(쿼터 소진·인증 실패·서버 과부하) 자동으로
# 다음 번호로 넘어간다.
GEMINI_MODEL=
# GEMINI_MODEL_1=
# GEMINI_MODEL_2=

# 판정 재현성을 위해 올리지 말 것
GEMINI_TEMPERATURE=0.1

# 안전장치
MAX_LLM_CALLS=20
LLM_CACHE_DIR=.cache

# ── AWS — SQS ─────────────────────────────────────────────
# Spring `dev` 프로필은 LocalStack의 lovebug-llm-request 큐로 요청을 보낸다.
# 이 워커는 메시지의 mode=MOCK이면 모델/DB 조회 없이 고정 결과를 Spring HTTP
# 콜백으로 돌려준다. 요청 큐 URL이 없으면 컨슈머는 시작하지 않는다.
AWS_REGION=ap-northeast-2
SQS_REQUEST_QUEUE_URL=http://localhost:4566/000000000000/lovebug-llm-request
# 비워두면 실제 AWS SQS. docker-compose.local.yml의 LocalStack을 쓰려면
# http://localhost:4566 로 채운다(scripts/README.md 참고) — 실제 백엔드
# 없이 로컬에서 전체 흐름(큐→처리→큐)을 확인할 수 있다.
SQS_ENDPOINT_URL=http://localhost:4566
# Spring 콜백 주소. 워커를 호스트에서 실행하면 기본값(http://localhost:8080)을
# 써도 되고, 컨테이너에서 실행하면 보통 http://host.docker.internal:8080 이다.
BACKEND_CALLBACK_BASE_URL=http://localhost:8080
# LocalStack은 자격증명을 검증하지 않지만 boto3는 뭐라도 있어야 한다 —
# LocalStack 쓸 때만 아무 문자열이나 채운다(실제 AWS에선 IAM 역할을 쓰므로 비워둔다).
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── MySQL ─────────────────────────────────────────────────
# 용도가 두 가지다: (1) app/idempotency.py의 멱등성 테이블(processed_jobs)
# (2) app/backend_db.py — 백엔드(Spring) DB에서 문서 본문(document/
# document_version.body)·사전집 용어(term)를 직접 읽음(2026-09-14, 읽기
# 전용). 둘 다 같은 DB(ubidict)를 가리킨다 — 로컬은 final/backend의
# compose.yaml이 띄우는 MySQL 컨테이너를 그대로 쓴다(별도 인스턴스 안 둠).
#
# 로컬에서 포트 확인하는 법: `docker port backend-mysql-1` — 컨테이너
# 재시작마다 호스트 포트가 바뀔 수 있다(Docker가 임의 포트를 새로 배정).
# db/schema.sql(processed_jobs)은 이 DB에 한 번 실행해두면 된다 —
# final/backend의 Flyway 마이그레이션과는 별개 테이블이라 섞이지 않는다.
MYSQL_HOST=localhost
MYSQL_PORT=
MYSQL_USER=ubidict
MYSQL_PASSWORD=ubidict
MYSQL_DATABASE=ubidict
