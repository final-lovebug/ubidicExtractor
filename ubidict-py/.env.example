# Gemini — test/.env.example과 동일한 규칙(§10 D-38~D-40, test/SPEC.md §6 참고)
# 키 1개만 쓰려면 GEMINI_API_KEY 하나만 채우면 된다.
# 여러 개 등록하면 1번부터 순서대로 쓰다가, 그 키가 쿼터 소진(429)·인증
# 실패(401/403)·무효 키(400 API_KEY_INVALID)로 막히면 자동으로 다음 번호로
# 넘어간다.
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# 모델도 마찬가지 — 하나만 쓰려면 GEMINI_MODEL만. 여러 개 등록하면 등록된
# 키를 전부 써도 그 모델이 안 될 때(쿼터 소진·인증 실패·서버 과부하) 자동으로
# 다음 번호로 넘어간다.
GEMINI_MODEL=
# GEMINI_MODEL_1=
# GEMINI_MODEL_2=

# 판정 재현성을 위해 올리지 말 것
GEMINI_TEMPERATURE=0.1

# 안전장치
MAX_LLM_CALLS=20
LLM_CACHE_DIR=.cache

# ── AWS — SQS ─────────────────────────────────────────────
# task.md/reference/backend/README.md 참고 — 큐 이름·ARN은 백엔드/인프라
# 확정 후 채운다. 지금은 로컬 개발 시 큐 연결 없이(HTTP 엔드포인트만으로도)
# 동작 확인이 가능하도록 컨슈머는 이 값이 없으면 시작하지 않는다.
AWS_REGION=ap-northeast-2
SQS_REQUEST_QUEUE_URL=
# 응답을 항상 고정된 큐로 보낼 거라면 여기, 메시지마다 replyQueueUrl을 실어
# 보낸다면 이 값은 기본값(폴백)으로만 쓴다 — queue_schema.py 참고.
SQS_REPLY_QUEUE_URL=
# 비워두면 실제 AWS SQS. docker-compose.local.yml의 LocalStack을 쓰려면
# http://localhost:4566 로 채운다(scripts/README.md 참고) — 실제 백엔드
# 없이 로컬에서 전체 흐름(큐→처리→큐)을 확인할 수 있다.
SQS_ENDPOINT_URL=
# LocalStack은 자격증명을 검증하지 않지만 boto3는 뭐라도 있어야 한다 —
# LocalStack 쓸 때만 아무 문자열이나 채운다(실제 AWS에선 IAM 역할을 쓰므로 비워둔다).
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── MySQL — 멱등성(idempotency) 전용 테이블 1개 ──────────────
# db/schema.sql 참고. 그 외 용도로 테이블을 늘리지 않는다(CloudWatch가 로그를
# 커버하므로) — SPEC 논의 참고. docker-compose.local.yml을 쓰면 아래 값 그대로
# (포트가 3307인 이유: 로컬 머신에 이미 3306으로 떠 있는 MySQL이 있을 수
# 있어 충돌을 피하려고 컨테이너를 3307에 매핑했다 — 실제로 이 프로젝트
# 개발 중에도 그런 충돌이 있었다).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=ubidict
MYSQL_PASSWORD=localdev
MYSQL_DATABASE=ubidict
